digraph Mira {
  rankdir=TB; nodesep=0.35; ranksep=0.55; fontname="Calibri"; bgcolor="white";
  node [fontname="Calibri", fontsize=11, shape=box, style="rounded,filled", fillcolor="#F2F5FA", color="#2F5597", penwidth=1.2];
  edge [fontname="Calibri", fontsize=9, color="#44546A"];

  user  [label="User (PM / TPM)\nChat window or API call", shape=box, fillcolor="#FFFFFF"];
  files [label="Provided project files\nproject_description.txt\nproject_timeline.csv\nproject_risks.csv\nsample_task_board.csv\n(or files attached to the request)", shape=folder, fillcolor="#FFF4D6", color="#C98A00"];

  subgraph cluster_in { label="Intake"; fontname="Calibri"; style="rounded"; color="#A6B2C5";
    trig [label="Triggers\nChat in | API in (webhook)"];
    cfg  [label="Config + Normalize request\nrun id, as-of date, project start,\nattached files detected by CSV header"];
  }
  subgraph cluster_orch { label="Orchestrator agent"; fontname="Calibri"; style="rounded"; color="#2F5597";
    cls   [label="Classify intent (LLM, gpt-4o-mini)\nplan | risk | top risks | status | counts |\nat-risk | milestones | stakeholder update", fillcolor="#D9E2F3"];
    route [label="Route + sufficiency gate (code)\nwhich project? is there enough data?", fillcolor="#D9E2F3"];
  }
  subgraph cluster_spec { label="Specialist agents"; fontname="Calibri"; style="rounded"; color="#2F5597";
    plan [label="Planner Agent\nLLM writes objectives + summary\nphases and milestones copied from timeline"];
    risk [label="Risk Assessor Agent\nLLM writes relevance + task evidence\nrisk matrix values copied from register"];
    stat [label="Status Reporter Agent\ncounts, tables, health by code\nLLM writes summary + actions\nstakeholder update email (sprint-bound)"];
    trk  [label="Milestone Tracker Agent\nblocked / at-risk / upcoming milestones by code\nLLM writes suggested actions"];
  }
  stop [label="Insufficient input / unclear request\nasks for scope, timeline, team size, task data\nno model call", fillcolor="#FDECEA", color="#B42318"];
  guard [label="Grounding validators (code)\nunknown task or risk ids, invented phases,\nunsupported figures, other-sprint content removed", fillcolor="#E7F4E8", color="#2E7D32"];
  fin  [label="Finalize\nMarkdown answer + footer (route, grounding status,\ntokens, cost) + trace payload"];
  llm  [label="OpenAI API\ngpt-4o-mini, JSON output, temperature 0", shape=component, fillcolor="#FFFFFF"];
  lf   [label="Langfuse (OpenTelemetry endpoint)\none trace per run, one generation per agent call", shape=component, fillcolor="#FFFFFF"];
  out  [label="Answer returned to chat / API\nplan | risk matrix | status report | email", fillcolor="#FFFFFF"];

  user -> trig; trig -> cfg; cfg -> cls; cls -> route; route -> plan; route -> risk; route -> stat; route -> trk; route -> stop [style=dashed, color="#B42318"];
  files -> cfg [style=dotted, label="read"]; files -> plan [style=dotted]; files -> risk [style=dotted]; files -> stat [style=dotted]; files -> trk [style=dotted];
  plan -> guard; risk -> guard; stat -> guard; trk -> guard; guard -> fin; stop -> fin; fin -> out; fin -> lf [label="trace"];
  cls -> llm [dir=both, style=dashed, constraint=false]; plan -> llm [dir=both, style=dashed, constraint=false]; risk -> llm [dir=both, style=dashed, constraint=false];
  stat -> llm [dir=both, style=dashed, constraint=false]; trk -> llm [dir=both, style=dashed, constraint=false];
}
