.""},{""role"":""user"",""content"":""{\""facts\"":{\""as_of\"":\""Friday 24 April 2026\"",\""sprint_scope\"":\""Sprint 3\"",\""counts_scope\"":{\""Done\"":0,\""In Progress\"":2,\""To Do\"":2,\""Blocked\"":0,\""Total\"":4},\""counts_board\"":{\""Done\"":5,\""In Progress\"":3,\""To Do\"":16,\""Blocked\"":1,\""Total\"":25},\""health\"":{\""level\"":\""AMBER\"",\""reasons\"":[\""1 blocked task(s): T024\"",\""1 overdue open task(s): T006\"",\""2 In Progress task(s) due within 7 days: T007, T025\""]},\""completed_in_scope\"":[],\""in_progress_in_scope\"":[{\""id\"":\""T007\"",\""name\"":\""Shortlist AI use cases\"",\""owner\"":\""Arjun Mehta\"",\""sprint\"":\""Sprint 3\"",\""due\"":\""28 April 2026\"",\""status\"":\""In Progress\""},{\""id\"":\""T025\"",\""name\"":\""Legal review of data usage\"",\""owner\"":\""Sarah Lin\"",\""sprint\"":\""Sprint 3\"",\""due\"":\""28 April 2026\"",\""status\"":\""In Progress\""}],\""todo_in_scope\"":[{\""id\"":\""T008\"",\""name\"":\""Define success criteria for each use case\"",\""owner\"":\""Sarah Lin\"",\""sprint\"":\""Sprint 3\"",\""due\"":\""2 May 2026\"",\""status\"":\""To Do\""},{\""id\"":\""T009\"",\""name\"":\""Vendor evaluation for ML platform\"",\""owner\"":\""James Wong\"",\""sprint\"":\""Sprint 3\"",\""due\"":\""5 May 2026\"",\""status\"":\""To Do\""}],\""blocked_on_board\"":[{\""id\"":\""T024\"",\""name\"":\""Security review of AI infrastructure\"",\""owner\"":\""James Wong\"",\""sprint\"":\""Sprint 5\"",\""due\"":\""26 May 2026\"",\""status\"":\""Blocked\""}],\""overdue_on_board\"":[{\""id\"":\""T006\"",\""name\"":\""Identify data gaps and quality issues\"",\""days_overdue\"":3}],\""due_within_7_days\"":[{\""id\"":\""T007\"",\""name\"":\""Shortlist AI use cases\"",\""days_to_due\"":4,\""status\"":\""In Progress\""},{\""id\"":\""T025\"",\""name\"":\""Legal review of data usage\"",\""days_to_due\"":4,\""status\"":\""In Progress\""}]}}""}]","{""summary"":""The current health level is AMBER due to one overdue task and two task